LLM_PROVIDER=openai             # openai | anthropic | gemini | groq | openrouter | ollama | compatible
LLM_API_KEY=                    # key of LLM_PROVIDER (any non-empty value for ollama)
# LLM_BASE_URL=                 # optional: OpenAI-compatible endpoint; overrides the preset URL (required for "compatible")
# Fallback (config/settings.yaml llm_fallback): used automatically when LLM_API_KEY is missing or
# rejected. Set the other provider's key here.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
EXTRACT_MODEL=                  # fast, low-cost model (e.g. gpt-6-luna, or gemini-2.5-flash with LLM_PROVIDER=gemini)
REASON_MODEL=                   # stronger model for validation and Q&A (e.g. gpt-6-sol, or gemini-2.5-pro)
# LLM_DEV_CACHE=1               # optional: cache identical LLM calls in storage/llm_cache/
# QDRANT_URL=http://localhost:6333   # with vector_store.kind: qdrant_server (config/settings.yaml or an overlay)
# QDRANT_API_KEY=
# RFP_SETTINGS_OVERLAY=config/docker.yaml   # optional: yaml merged over config/settings.yaml
